{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-commit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch policy..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-bare-python.sh\"",
            "timeout": 10,
            "statusMessage": "Checking interpreter policy..."
          }
        ]
      }
    ]
  }
}
