# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
.vscode/

data/

# ...but the volcano post's DESeq2 table is source, not scratch: its `fig-airway`
# and `fig-ma` cells read it at render time, so a clone without it cannot rebuild
# the post. Un-ignore the directory first -- git will not descend into an excluded
# directory to find a negated file inside it.
!posts/volcano-plots/data/
!posts/volcano-plots/data/**


experimental/*
!experimental/.gitkeep

/.quarto/
 .nojekyll
.DS_Store

# _freeze/ is deliberately NOT ignored -- it is tracked. Quarto's frozen output
# is what lets a machine without the computational toolchain render this project,
# and the legacy posts listed in LEGACY_NO_ENV (scripts/check_posts.py) have no
# venv, no pinned kernel and no requirements.txt, so their frozen output is the
# *only* reproducible record of them. Ignoring it meant a single `rm -rf` or a
# fresh clone lost them silently. It is also the prerequisite for ever rendering
# the site in CI with no ML dependencies installed. See CLAUDE.md ("Why _freeze/
# is committed").

# Ignore all files and folders containing "DELETE-ME" in their names
*DELETE-ME*

# ignore R environment files
.renv

# Claude Code personal settings
.claude/settings.local.json

# knitr/Quarto build artifacts in post source dirs (the published copies live in docs/)
posts/**/index_cache/
posts/**/index_files/

# Trainer/SetFit write checkpoints relative to the render's cwd, so rendering a
# fine-tuning post drops hundreds of MB of weights into the post directory (and
# `checkpoints/` at the repo root). They are build artifacts -- the published
# numbers live in _freeze/ and docs/. Never commit them.
checkpoints/
posts/**/checkpoints/
posts/**/results/
